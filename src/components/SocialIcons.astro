---
import { site, type Social } from '../config/site';

const labels: Record<Social['type'], string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  vimeo: 'Vimeo',
  youtube: 'YouTube',
  telegram: 'Telegram',
  email: 'Email',
};

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = site.socials.filter((s) => s.url.trim().length > 0);
const isExternal = (url: string) => !url.startsWith('mailto:') && !url.startsWith('tel:');
---

{links.length > 0 && (
  <ul class:list={['socials', className]}>
    {links.map((social) => (
      <li>
        <a
          href={social.url}
          title={labels[social.type]}
          aria-label={labels[social.type]}
          {...(isExternal(social.url) ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {social.type === 'instagram' && (
              <g fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none" />
              </g>
            )}
            {social.type === 'facebook' && (
              <path
                fill="currentColor"
                d="M13.6 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1A22 22 0 0 0 14.4 3c-2.5 0-4.2 1.5-4.2 4.2v2.4H7.4v3.2h2.8V21z"
              />
            )}
            {social.type === 'vimeo' && (
              <path
                fill="currentColor"
                d="M23.977 6.417c-.105 2.338-1.739 5.543-4.894 9.609-3.268 4.247-6.026 6.37-8.29 6.37-1.409 0-2.578-1.294-3.553-3.881L5.322 11.4C4.603 8.816 3.834 7.522 3.01 7.522c-.179 0-.806.378-1.881 1.132L0 7.216a315 315 0 0 0 3.501-3.128C5.08 2.701 6.266 1.984 7.055 1.91c1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.507.539 2.45 1.131 3.674 1.776 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.868 3.434-5.757 6.762-5.637 2.473.06 3.628 1.664 3.493 4.797z"
              />
            )}
            {social.type === 'youtube' && (
              <g>
                <rect
                  x="2.5"
                  y="5"
                  width="19"
                  height="14"
                  rx="4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path fill="currentColor" d="M10.2 8.9v6.2L15.6 12z" />
              </g>
            )}
            {social.type === 'telegram' && (
              <path
                fill="currentColor"
                d="M20.7 3.7 3.2 10.5c-1 .4-1 1.7 0 2l4.4 1.4 1.7 5.3c.3.9 1.4 1.1 2 .5l2.5-2.4 4.5 3.3c.8.6 1.9.1 2.1-.8l3-14.3c.2-1.1-.8-2-1.7-1.8Zm-3.6 4.1-6.8 6.2-.3 2.9-1.3-3.9 8.4-5.2Z"
              />
            )}
            {social.type === 'email' && (
              <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                <rect x="2.5" y="5" width="19" height="14" rx="2" />
                <path d="m3.5 7 8.5 6.5L20.5 7" />
              </g>
            )}
          </svg>
          <span class="visually-hidden">{labels[social.type]}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .socials {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #dedede;
    color: #000;
    transition: background 0.2s;
  }

  .socials a:hover {
    background: #fff;
  }

  .socials svg {
    width: 16px;
    height: 16px;
  }
</style>
