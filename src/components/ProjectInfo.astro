---
interface Props {
  title: string;
  hasBody?: boolean;
}

const { title, hasBody = false } = Astro.props;
---

<section class="info">
  <h1>{title}</h1>

  {hasBody && (
    <div class="body">
      <slot />
    </div>
  )}
</section>

<style>
  .info {
    padding: 4.8rem var(--side-pad) 2.4rem;
  }

  h1 {
    font-size: var(--h1-size);
    font-weight: var(--h1-weight);
    line-height: var(--h1-lh);
    color: var(--title-color);
    margin: 0 0 1.6rem;
  }

  .body :global(p) {
    font-size: var(--copy-size);
    line-height: var(--copy-lh);
    letter-spacing: var(--copy-ls);
    color: var(--text);
    text-align: justify;
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 1.8rem;
  }
</style>
