---
// One page per side role (/gaffer, /colorist), under the MORE menu: the same layout, fed by a config.
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from './Media.astro';
import Lightbox from './Lightbox.astro';
import { site } from '../config/site';
import type { RolePage } from '../config/role-page';
import { mediaHref } from '../lib/media';

interface Props {
  page: RolePage;
}

const { page } = Astro.props;

const linkLabel = (url: string) =>
  /youtu\.?be/.test(url)
    ? 'WATCH ON YOUTUBE'
    : /instagram\.com/.test(url)
      ? 'WATCH ON INSTAGRAM'
      : 'WATCH ON VIMEO';

/**
 * Column spans on a 6-column grid, so any count from 1 to 6 fills its rows:
 * 4 -> 2 + 2, 5 -> 3 + 2 (the last two wider). Portrait frames all sit in one row.
 */
const spansFor = (count: number, portrait: boolean): number[] => {
  if (portrait) return Array(count).fill(6 / count);
  if (count === 5) return [2, 2, 2, 3, 3];
  const span = count === 4 ? 3 : 6 / Math.min(count, 3);
  return Array(count).fill(span);
};

// One lightbox for the whole page, so every still gets an index across all projects.
let offset = 0;
const projects = page.projects.map((p, i) => {
  const ratio = p.ratio?.trim() || '16/9';
  const [w, h] = ratio.split('/').map(Number);
  const srcs = p.stills.map((s) => s.trim()).filter(Boolean).slice(0, 6);
  const spans = spansFor(srcs.length, h > w);
  // Phones: three across even for portrait frames, which would be too thin in one row.
  const phoneSpans = spansFor(srcs.length, false);
  // Height of the grid as a share of its width: add up the first still of each row.
  let gridHeight = 0;
  let filled = 0;
  for (const span of spans) {
    if (filled % 6 === 0) gridHeight += (span / 6) * (h / w);
    filled += span;
  }
  return {
    ...p,
    ratio,
    gridHeight,
    number: String(i + 1).padStart(2, '0'),
    stills: srcs.map((src, j) => ({ src, span: spans[j], phoneSpan: phoneSpans[j], index: offset++ })),
  };
});
const allStills = projects.flatMap((p) => p.stills.map((s) => s.src));
const contact = site.about.contacts[0];
---

<BaseLayout title={page.role} description={page.description}>
  <header class="top">
    <h1 class="page-title">{page.role}</h1>
  </header>

  {projects.map((p) => (
    <section
      class="project"
      aria-labelledby={`p-${p.number}`}
      style={`--grid-h:${p.gridHeight}`}
    >
      <div class="project-head">
        <div>
          <p class="project-number">{p.number}</p>
          <h2 class="project-title" id={`p-${p.number}`}>{p.title}</h2>
          {p.credits.trim() && <p class="project-credits">{p.credits}</p>}
        </div>
        {p.link.trim() && (
          <a class="watch" href={p.link} target="_blank" rel="noopener">
            {linkLabel(p.link)} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>

      <div class="stills">
        {p.stills.map(({ src, span, phoneSpan, index }, i) => (
          <a
            class="still"
            href={mediaHref(src)}
            data-lightbox-index={index}
            aria-label={`${p.title} — still ${i + 1}, open full screen`}
            style={`--span:${span};--phone-span:${phoneSpan}`}
          >
            <Media
              src={src}
              alt={`${p.title} — still ${i + 1}`}
              ratio={p.ratio}
              sizes={`(min-width: 681px) ${Math.round((span / 6) * 90)}vw, ${Math.round((phoneSpan / 6) * 100)}vw`}
            />
          </a>
        ))}
      </div>
    </section>
  ))}

  <footer class="bottom">
    {contact && (
      <p class="contacts">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
      </p>
    )}
  </footer>

  {allStills.length > 0 && <Lightbox items={allStills} title={`${site.name} — ${page.role}`} />}
</BaseLayout>

<style>
  .top {
    padding: 3.2rem 3.2rem 0;
  }

  .page-title {
    margin: 0;
    font-size: var(--h1-size);
    font-weight: var(--h1-weight);
    line-height: var(--h1-lh);
    color: var(--title-color);
  }

  .project {
    padding: 2.4rem 3.2rem 4.8rem;
  }

  .project-head,
  .stills {
    /* Cap the width by the screen height (--grid-h is the grid's height/width),
       so a whole project fits on one screen. */
    width: min(100%, calc((100svh - 20rem) / var(--grid-h, 0.375)));
    margin-inline: auto;
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.4rem;
    margin-bottom: 1.6rem;
    color: #fff;
  }

  .project-number {
    margin: 0 0 0.4rem;
    font-size: var(--copy-size);
    color: #777;
    letter-spacing: 0.1em;
  }

  .project-title {
    margin: 0;
    font-size: var(--h1-size);
    font-weight: var(--h1-weight);
    line-height: 1.2;
  }

  .project-credits {
    margin: 0.6rem 0 0;
    font-size: var(--copy-size);
    line-height: var(--copy-lh);
    letter-spacing: var(--copy-ls);
    color: var(--text);
  }

  .watch {
    flex-shrink: 0;
    font-size: var(--menu-size);
    line-height: var(--menu-lh);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
  }

  .stills {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gutter);
  }

  .still {
    display: block;
    grid-column: span var(--span, 2);
    cursor: zoom-in;
    transition: opacity 0.25s ease-in-out;
  }

  @media (hover: hover) {
    .still:hover {
      opacity: 0.75;
    }
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.6rem;
    padding: 0 3.2rem 4rem;
  }

  .contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    margin: 0;
    font-size: var(--copy-size);
    line-height: var(--copy-lh);
    letter-spacing: var(--copy-ls);
  }

  @media (max-width: 680px) {
    .top {
      padding: 2rem 2rem 0;
    }

    .project {
      padding: 2rem 2rem 4rem;
    }

    .project-head,
    .stills {
      width: 100%;
    }

    .project-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.6rem;
    }

    /* Same size as the name and role at the top, so long titles fit on a line or two. */
    .project-title {
      font-size: var(--site-title-size);
    }

    /* Phones: three across, portrait frames included. */
    .still {
      grid-column: span var(--phone-span, 2);
    }

    .bottom {
      padding: 0 2rem 4rem;
    }
  }
</style>
