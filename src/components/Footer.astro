---
import { site } from '../config/site';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
// ABOUT shows the icons under the contacts, so the footer doesn't repeat them there.
const onAbout = Astro.url.pathname.replace(/\/$/, '') === '/about';
---

<footer>
  {!onAbout && <SocialIcons />}
  <p class="copyright visually-hidden">
    © {year} {site.name}. All rights reserved.
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    background: #000;
    padding: 4rem 3.2rem;
  }

  .copyright {
    font-size: var(--copy-size);
    line-height: var(--copy-lh);
    margin: 1.6rem 0 0;
  }
</style>
