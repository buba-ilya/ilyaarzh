---
import { Image } from 'astro:assets';
import MediaPlaceholder from './MediaPlaceholder.astro';
import { resolveAsset } from '../lib/media';

interface Props {
  items: string[];
  title: string;
}

const { items, title } = Astro.props;

const resolve = (src?: string) => {
  const trimmed = src?.trim();
  if (!trimmed) return { kind: 'placeholder' as const };
  const asset = resolveAsset(trimmed);
  return asset ? { kind: 'asset' as const, asset } : { kind: 'url' as const, url: trimmed };
};

const slides = items.map((src, i) => ({ ...resolve(src), index: i }));
---

<dialog class="lb" data-lightbox aria-label={`${title} — stills`}>
  <div class="lb-stage" data-stage>
    {slides.map((slide) => (
      <figure class="lb-slide" data-slide={slide.index}>
        {slide.kind === 'placeholder' && (
          <div class="lb-ph">
            <MediaPlaceholder ratio="16/9" />
          </div>
        )}
        {slide.kind === 'asset' && (
          <Image
            src={slide.asset}
            alt={`${title} — still ${slide.index + 1}`}
            widths={[960, 1440, 1920, 2560]}
            sizes="100vw"
            loading="lazy"
          />
        )}
        {slide.kind === 'url' && (
          <img
            src={slide.url}
            alt={`${title} — still ${slide.index + 1}`}
            loading="lazy"
            decoding="async"
          />
        )}
      </figure>
    ))}
  </div>

  {items.length > 1 && (
    <>
      <button class="lb-nav lb-prev" data-prev type="button" aria-label="Previous still">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M15 4 7 12l8 8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button class="lb-nav lb-next" data-next type="button" aria-label="Next still">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="m9 4 8 8-8 8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </>
  )}

  <div class="lb-tools">
    <button class="lb-tool" data-close type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="m5 5 14 14M19 5 5 19"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>

  <p class="visually-hidden" aria-live="polite" data-counter></p>
</dialog>

<style>
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .lb::backdrop {
    background: var(--lightbox-bg);
  }

  .lb.is-open {
    opacity: 1;
  }

  .lb-stage {
    cursor: zoom-out;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .lb-slide {
    display: none;
    margin: 0;
    transform: scale(0.96);
    transition: transform 0.3s ease-in-out;
  }

  .lb-slide.is-active {
    display: block;
  }

  .lb.is-open .lb-slide.is-active {
    transform: scale(1);
  }

  .lb-slide :global(img) {
    max-width: 100vw;
    max-height: 100vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb-ph {
    width: min(90vw, 160vh);
  }

  .lb-nav,
  .lb-tool {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--lightbox-icon);
    cursor: pointer;
    transition: color 0.2s;
  }

  .lb-nav:hover,
  .lb-tool:hover {
    color: #fff;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
  }

  .lb-prev {
    left: 0.8rem;
  }

  .lb-next {
    right: 0.8rem;
  }

  .lb-tools {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    display: flex;
    gap: 0.4rem;
  }

  .lb-tool {
    position: static;
    width: 40px;
    height: 40px;
  }

  .lb-nav svg,
  .lb-tool svg {
    width: 24px;
    height: 24px;
  }
</style>

<script>
  const init = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';

    const slides = Array.from(dialog.querySelectorAll<HTMLElement>('[data-slide]'));
    const counter = dialog.querySelector<HTMLElement>('[data-counter]');
    if (slides.length === 0) return;

    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    const open = (index: number, from: HTMLElement) => {
      opener = from;
      show(index);
      dialog.showModal();
      requestAnimationFrame(() => dialog.classList.add('is-open'));
    };

    const close = () => dialog.close();

    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-index]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        open(Number(link.dataset.lightboxIndex ?? 0), link);
      });
    });

    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-close]')?.addEventListener('click', close);

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    let startX = 0;
    let tracking = false;
    // A swipe also ends in a click event; remember it so the swipe doesn't close.
    let swiped = false;

    dialog.addEventListener('pointerdown', (event) => {
      tracking = true;
      swiped = false;
      startX = event.clientX;
    });

    dialog.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 50) {
        swiped = true;
        show(delta < 0 ? current + 1 : current - 1);
      }
    });

    // Any click that isn't on a control closes — on the still itself or the backdrop.
    dialog.addEventListener('click', (event) => {
      if (swiped) {
        swiped = false;
        return;
      }
      if ((event.target as HTMLElement).closest('button')) return;
      close();
    });

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-open');
      opener?.focus();
      opener = null;
    });
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
