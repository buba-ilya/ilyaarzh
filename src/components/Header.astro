---
import { site } from '../config/site';

interface Props {
  /** Which nav href should be marked as the current page. */
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;

const matches = (href: string) =>
  href === '/'
    ? current === '/'
    : href !== '' &&
      (current.startsWith(href) || (href === '/work' && current.startsWith('/portfolio')));

// A parent counts as current when one of its pages is open.
const isCurrent = (item: (typeof site.nav)[number]) =>
  matches(item.href) || (item.children ?? []).some((child) => matches(child.href));
---

<header>
  <div class="header-inner capped-flush">
    <a class="brand" href="/">
      <span class="brand-name">{site.name}</span>
      <span class="brand-role">{site.role}</span>
    </a>

    <nav aria-label="Main">
      <ul class="menu">
        {site.nav.map((item) => (
          <li class:list={['menu-item', item.children?.length && 'has-children']}>
            {item.href ? (
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                {item.label}
              </a>
            ) : (
              <button
                type="button"
                class="toggle"
                aria-expanded="false"
                data-current={isCurrent(item) ? '' : undefined}
              >
                {item.label}
              </button>
            )}

            {item.children && item.children.length > 0 && (
              <div class="sub-menu">
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={matches(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Tap to open a menu without its own page (MORE); tap anywhere else to close it.
  const toggles = document.querySelectorAll<HTMLButtonElement>('header .toggle');
  const close = (except?: HTMLButtonElement) =>
    toggles.forEach((t) => {
      if (t !== except) t.setAttribute('aria-expanded', 'false');
    });
  toggles.forEach((toggle) =>
    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      close(toggle);
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    }),
  );
  document.addEventListener('click', () => close());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
</script>

<style>
  header {
    position: relative;
    z-index: 200;
    background: #000;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .brand {
    padding: 3.2rem;
    color: #fff;
  }

  .brand:hover {
    color: #fff;
  }

  .brand-name,
  .brand-role {
    display: block;
  }

  .brand-name {
    font-size: var(--site-title-size);
    line-height: var(--site-title-lh);
    font-weight: 400;
  }

  .brand-role {
    font-size: var(--site-subtitle-size);
  }

  .menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 3.2rem 3.2rem 3.2rem 0;
  }

  .menu-item {
    position: relative;
    margin-left: var(--menu-gap);
  }

  .menu-item:first-child {
    margin-left: 0;
  }

  .menu-item > a,
  .toggle {
    font-size: var(--menu-size);
    line-height: var(--menu-lh);
    color: #fff;
  }

  .menu-item > a:hover {
    color: #dedede;
  }

  /* MORE: a step back from WORK and ABOUT. */
  .toggle {
    font-family: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: #8a8a8a;
  }

  .toggle:hover,
  .toggle[aria-expanded='true'],
  .toggle[data-current] {
    color: #fff;
  }

  /* Dropdown: opens on hover where there is one, and on tap via the toggle script. */
  .sub-menu {
    position: absolute;
    top: 70%;
    right: -3.2rem;
    padding-top: 1.2rem;
    opacity: 0;
    visibility: hidden;
    transition:
      all 0.3s ease-in-out,
      visibility 0s linear 0.3s;
  }

  .toggle[aria-expanded='true'] + .sub-menu {
    top: 100%;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (hover: hover) {
    .has-children:hover .sub-menu,
    .has-children:focus-within .sub-menu {
      top: 100%;
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
  }

  .sub-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem 3.2rem;
    background: #000;
    white-space: nowrap;
    text-align: right;
  }

  .sub-menu li {
    padding: 0.8rem 0;
  }

  .sub-menu a {
    font-size: var(--menu-size);
    line-height: var(--menu-lh);
    color: #fff;
  }

  .sub-menu a:hover,
  .sub-menu a[aria-current='page'] {
    color: #8a8a8a;
  }

  @media (max-width: 399px) {
    .brand {
      padding: 2rem;
    }

    .menu {
      padding: 2rem 2rem 2rem 0;
    }

    .menu-item {
      margin-left: 2rem;
    }

    .sub-menu {
      right: -2rem;
    }

    .sub-menu ul {
      padding: 0.4rem 2rem;
    }
  }
</style>
